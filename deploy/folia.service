# Exemple : adapter chemins, utilisateur et chemin absolu du binaire Node 22 maintenu.
[Unit]
Description=API Phytolie
After=network.target

[Service]
Type=simple
User=folia
Group=folia
WorkingDirectory=/srv/phytolie
EnvironmentFile=/etc/folia/api.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --experimental-strip-types /srv/phytolie/server/index.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/folia
StateDirectory=folia
StateDirectoryMode=0700
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
CapabilityBoundingSet=
# Ajuster selon le volume réel des jardins et les mesures de charge.
MemoryMax=768M
TasksMax=64
LimitNOFILE=1024
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
