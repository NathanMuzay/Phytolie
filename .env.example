# Créez votre clé sur https://admin.kindwise.com/
PLANT_ID_API_KEY=

# Remplacez cette adresse par l'IPv4 locale de l'ordinateur.
# Le téléphone et l'ordinateur doivent être sur le même Wi-Fi.
# Avec npm run demo, cette adresse est ignorée : l'API utilise le tunnel Expo.
EXPO_PUBLIC_API_URL=http://192.168.1.42:8787

API_PORT=8787
API_HOST=0.0.0.0

# Origines web exactes autorisées (sans slash final). Sans Origin : clients natifs acceptés.
# Adapter au port Expo utilisé. Jamais de * ni de "null".
FOLIA_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# En production : NODE_ENV=production, API_HOST=127.0.0.1 et proxy HTTPS local.
# Ne définir ces adresses QUE si le proxy remplace X-Forwarded-For / Proto.
# FOLIA_TRUSTED_PROXIES=127.0.0.1,::1
# Inscriptions fermées par défaut en production ; ouverture explicite si souhaitée.
# FOLIA_ALLOW_REGISTRATION=false

# Clés secrètes indépendantes : chacune 32 octets aléatoires en hexadécimal (64 caractères).
# Génération, migration et sauvegarde détaillées dans SECURITY.md.
# FOLIA_DATA_KEY=
# FOLIA_AUDIT_KEY=
# FOLIA_BACKUP_KEY=

# Plafonds globaux de tentatives payantes par fenêtre de 24 h (persistants).
FOLIA_IDENTIFY_DAILY_LIMIT=200
FOLIA_MEASURE_DAILY_LIMIT=100

# Facultatif : fichier de stockage des comptes (défaut : data/folia.sqlite).
# FOLIA_DB_PATH=data/folia.sqlite

# Facultatif : mesure automatique des dimensions sur photo avec repère d’échelle.
# Clé secrète côté serveur uniquement. Sans cette clé, placement manuel des points disponible.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1
