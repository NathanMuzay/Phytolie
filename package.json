{
  "name": "folia",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-notifications": "~57.0.24",
    "expo-sensors": "~57.0.3",
    "react": "19.3.1",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "mobile": "expo start --go --lan --clear",
    "demo": "node --env-file-if-exists=.env scripts/demo.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "api": "node --experimental-strip-types --env-file-if-exists=.env server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test:security": "node --experimental-strip-types --test tests/security*.test.mjs tests/accounts*.test.mjs tests/delegations.test.mjs",
    "test:api-runtime": "node scripts/check-api-runtime.mjs",
    "security:migrate": "node --experimental-strip-types --env-file-if-exists=.env scripts/security-migrate.mjs",
    "security:rotate-key": "node --experimental-strip-types --env-file-if-exists=.env scripts/security-rotate-key.mjs",
    "security:backup": "node --env-file-if-exists=.env scripts/security-backup.mjs backup",
    "security:restore": "node --env-file-if-exists=.env scripts/security-backup.mjs restore",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  },
  "private": true
}
